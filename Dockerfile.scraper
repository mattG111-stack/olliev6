FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /app
COPY requirements.txt requirements-scraper.txt ./
RUN pip install --no-cache-dir -r requirements-scraper.txt && python -m playwright install --with-deps chromium --only-shell
COPY . .
CMD ["python", "scraper_worker.py"]
